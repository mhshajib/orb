# Server-only API base — where the Nitro proxy forwards /api/* and /platform/api/*
NUXT_API_BASE=

# Public websocket base — exposed to the client for the WS connect URL
NUXT_PUBLIC_WS_BASE=

# Shared free-tier sending domain (must match backend mailer.shared_sending_domain)
NUXT_PUBLIC_SHARED_SENDING_DOMAIN=
